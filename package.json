{
  "name": "nium-api-health-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prototype: Nium API Integration Health Dashboard (synthetic telemetry only)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "build:preview-file": "vite build --mode singlefile",
    "typecheck": "tsc -b --noEmit",
    "data:generate": "node scripts/generate-mock-data.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "tokens:contrast": "node scripts/contrast-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/blinker": "^5.1.0",
    "@fontsource/roboto-mono": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
